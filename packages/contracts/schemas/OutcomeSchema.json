{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "variant_id": {
      "type": "string"
    },
    "exposed": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 1
      }
    },
    "engaged": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 1
      }
    },
    "objected": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 1
      }
    },
    "sentiment": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": -1,
        "maximum": 1
      }
    },
    "shared": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 1
      }
    },
    "via_anger": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 1
      }
    },
    "ticks": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "from": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "to": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "anger": {
              "type": "boolean"
            }
          },
          "required": [
            "from",
            "to",
            "anger"
          ],
          "additionalProperties": false
        }
      }
    }
  },
  "required": [
    "variant_id",
    "exposed",
    "engaged",
    "objected",
    "sentiment",
    "shared",
    "via_anger",
    "ticks",
    "edges"
  ],
  "additionalProperties": false
}