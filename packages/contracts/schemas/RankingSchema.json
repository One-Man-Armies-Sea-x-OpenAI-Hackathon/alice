      "type": "string",
      "enum": [
        "region",
        "age",
        "platform",
        "religion",
        "tier"
      ]
    },
    "group": {
      "type": "string"
    },
    "winner": {
      "type": "string"
    },
    "order": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "margin": {
      "type": "number"
    },
    "why": {
      "type": "string"
    }
  },
  "required": [
