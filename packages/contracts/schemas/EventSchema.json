{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "run_id": {
      "type": "string"
    },
    "seq": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "time_ms": {
      "type": "number",
      "minimum": 0
    },
    "type": {
      "type": "string",
      "enum": [
        "stage",
        "brief",
        "audience",
        "reaction",
        "spread",
        "rollup",
        "robustness",
        "baseline",
        "risk",
        "fix",
        "done",
        "error"
      ]
    },
    "data": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "run_id",
    "seq",
    "time_ms",
    "type",
    "data"
  ],
  "additionalProperties": false
}